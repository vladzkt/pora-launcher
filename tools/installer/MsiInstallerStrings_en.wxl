  <String Id="MaintenanceTypeDlgRepairText" Overridable="yes">Восстановить испорченные или пропавшие файлы лаунчера.</String>
  <String Id="MaintenanceTypeDlgRemoveButton" Overridable="yes">&amp;Удалить</String>
  <String Id="MaintenanceTypeDlgRemoveText" Overridable="yes">Убрать лаунчер с компьютера. Игра и моды останутся.</String>
  <String Id="MaintenanceTypeDlgChangeButton" Overridable="yes">&amp;Изменить</String>
  <String Id="MaintenanceTypeDlgChangeText" Overridable="yes">Изменить установку.</String>

