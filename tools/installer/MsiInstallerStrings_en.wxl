  <String Id="MsiRMFilesInUseDontUseRM" Overridable="yes">&amp;Не закрывать</String>

  <!-- Мало места -->
  <String Id="OutOfDiskDlg_Title" Overridable="yes">Пора Копать — установка</String>
  <String Id="OutOfDiskDlgTitle" Overridable="yes">{\PkTitle}Мало места</String>
  <String Id="OutOfDiskDlgDescription" Overridable="yes">{\PkBody}На диске не хватает места.</String>
  <String Id="OutOfDiskDlgText" Overridable="yes">Освободи место и попробуй снова.</String>
  <String Id="OutOfRbDiskDlg_Title" Overridable="yes">Пора Копать — установка</String>
  <String Id="OutOfRbDiskDlgTitle" Overridable="yes">{\PkTitle}Мало места</String>
